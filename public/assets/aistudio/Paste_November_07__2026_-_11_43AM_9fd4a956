        snapshot.forEach((d) => {
          const data = d.data();
          map[data.itemId] = {
            isCompleted: !!data.isCompleted,
            minutesListened: data.minutesListened || 0,
            durationMin: data.durationMin || 0,
            percentage: data.percentage || (data.isCompleted ? 100 : 0),
            updatedAt: data.updatedAt,
