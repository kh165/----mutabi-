        performedCount,
        completed,
        { prayers: prayersDetails },
        dayNote.trim()
      );
      onClose();
    } catch (err) {
      setError(err?.message || 'حدث خطأ أثناء حفظ الصلوات');
    } finally {
      setSaving(false);
    }
  };

