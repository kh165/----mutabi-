              ...item,
              status: item.status === status ? null : status,
            }
          : item
      )
    );
  };

  const setPrayerNote = (id, noteText) => {
    setPrayers((prev) =>
      prev.map((item) => (item.id === id ? { ...item, note: noteText } : item))
    );
