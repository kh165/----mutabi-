rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper Functions ----------
    function signedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(uid) { 
      return signedIn() && request.auth.uid == uid; 
    }
    
    function isRootAdminEmail() {
      return signedIn() && (
        request.auth.token.email == 'khalid.niletechno@gmail.com' ||
        request.auth.token.email == 'khalidsalah9444@gmail.com' ||
        request.auth.token.email == 'khalidsalah948@gmail.com'
      );
    }

    function isAdmin() {
      return signedIn() && (
        isRootAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function canMonitorUser(uid) {
      return isAdmin()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('adminMonitoringConsent', false) == true;
    }
    
    function notDisabled() {
      return !(exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDisabled', false) == true);
    }
    
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------- test connection ----------
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || canMonitorUser(uid);
      allow list: if isAdmin() && resource.data.get('adminMonitoringConsent', false) == true;
      allow create: if isOwner(uid) 
                    && request.resource.data.get('isDisabled', false) == false
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 100;
      allow update: if (isOwner(uid) && unchanged('isDisabled') && unchanged('createdAt')
                        && request.resource.data.displayName is string
                        && request.resource.data.displayName.size() <= 100)
                    || (canMonitorUser(uid)
                        && unchanged('adminMonitoringConsent')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDisabled']));
      allow delete: if false;

      match /adhkarProgress/{progressId} {
        allow get, list: if isOwner(uid) || canMonitorUser(uid);
        allow create, update: if isOwner(uid)
          && notDisabled()
          && request.resource.data.keys().hasOnly([
            'uid', 'date', 'categoryId', 'dhikrId', 'count', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'date', 'categoryId', 'dhikrId', 'count'
          ])
          && request.resource.data.date is string
          && request.resource.data.categoryId is string
          && request.resource.data.dhikrId is string
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 100
          && progressId == request.resource.data.date + '_' +
            request.resource.data.categoryId + '_' + request.resource.data.dhikrId
          && (!('uid' in request.resource.data) || request.resource.data.uid == uid);
        allow delete: if isOwner(uid) && notDisabled();
      }
    }

    // ---------- admins ----------
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if (isOwner(uid) && isRootAdminEmail()) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- activities ----------
    match /activities/{activityId} {
      allow read, list: if signedIn() && notDisabled();
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read, list: if signedIn() && notDisabled();
        allow write: if isAdmin();
      }
    }

    // ---------- logs ----------
    match /logs/{logId} {
      allow read, list: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        canMonitorUser(resource.data.uid)
      );
      allow create: if signedIn() && notDisabled() 
                    && request.resource.data.uid == request.auth.uid
                    && logId == request.auth.uid + '_' + request.resource.data.activityId + '_' + request.resource.data.date
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0
                    && request.resource.data.amount <= 100000;
      allow update: if signedIn() && notDisabled() 
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0
                    && request.resource.data.amount <= 100000;
      allow delete: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        canMonitorUser(resource.data.uid)
      );
    }

    // ---------- itemProgress ----------
    match /itemProgress/{id} {
      allow read, list: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        canMonitorUser(resource.data.uid)
      );
      allow create: if signedIn() && notDisabled() 
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && notDisabled() 
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        canMonitorUser(resource.data.uid)
      );
    }

    // ---------- notes ----------
    match /notes/{noteId} {
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if (signedIn() && resource.data.toUid == request.auth.uid 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
                    || (signedIn()
                        && resource.data.toUid == request.auth.uid
                        && resource.data.get('reply', null) == null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
                        && request.resource.data.reply is map
                        && request.resource.data.reply.keys().hasOnly([
                          'fromUid', 'fromName', 'text', 'createdAt'
                        ])
                        && request.resource.data.reply.keys().hasAll([
                          'fromUid', 'fromName', 'text', 'createdAt'
                        ])
                        && request.resource.data.reply.fromUid == request.auth.uid
                        && request.resource.data.reply.fromName is string
                        && request.resource.data.reply.fromName.size() <= 100
                        && request.resource.data.reply.text is string
                        && request.resource.data.reply.text.size() > 0
                        && request.resource.data.reply.text.size() <= 1000
                        && request.resource.data.reply.createdAt == request.time)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- encouragements ----------
    match /encouragements/{quoteId} {
      allow read, list: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Global Catch-All Deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
