## 10. قواعد الأمان (Security Rules)

ملف `firestore.rules`:

```js
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function notDisabled() {
      return !(get(/databases/$(database)/documents/users/$(request.auth.uid))
                .data.get('isDisabled', false));
    }
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.isDisabled == false;
      // المستخدم لا يستطيع تعديل isDisabled / createdAt
      allow update: if (isOwner(uid) && unchanged('isDisabled') && unchanged('createdAt'))
                    || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- admins (للقراءة الذاتية فقط، الكتابة من Console) ----------
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---------- activities ----------
    match /activities/{activityId} {
      allow read: if signedIn() && notDisabled();
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if signedIn() && notDisabled();
        allow write: if isAdmin();
      }
    }

    // ---------- logs ----------
    match /logs/{logId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && notDisabled()
                    && request.resource.data.uid == request.auth.uid
                    && logId == request.auth.uid + '_' + request.resource.data.activityId
                                + '_' + request.resource.data.date
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0
                    && request.resource.data.amount <= 100000;
      allow update: if signedIn() && notDisabled()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- itemProgress ----------
    match /itemProgress/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && notDisabled()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---------- notes ----------
    match /notes/{noteId} {
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      // المستخدم يقدر فقط يعلّم الملاحظة كمقروءة
      allow update: if (signedIn() && resource.data.toUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
                    || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
```

