      await setDoc(newDocRef, {
        ...item,
        id: newDocRef.id,
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp(),
      });
    }
  };

  return {
    activities,
    loading,
    saveActivity,
    deleteActivity,
    reorderActivities,
    seedPresetsToDatabase,
  };
}

