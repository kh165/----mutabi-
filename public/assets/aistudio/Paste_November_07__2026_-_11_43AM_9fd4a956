  const initialFrom = currentLog?.details?.fromAyah || (latestPosition?.toAyah ? latestPosition.toAyah + 1 : 1);
  const initialTo = currentLog?.details?.toAyah || initialFrom + Math.max(1, dailyTarget - 1);

